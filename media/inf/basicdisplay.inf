; BasicDisplay.INF
;
; Installation file for the WDDM Basic Display Driver
;
[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = System
ClassGUID  = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 09/22/2026,1.00

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%StdMfg% = StdMfg

; The kernel only reports this device on UEFI boots
[StdMfg]
%BasicDisplay.DeviceDesc% = BasicDisplay_Inst,ROOT\BASICDISPLAY

;------------------------- BASIC DISPLAY DRIVER -------------------------

[BasicDisplay_Inst.NT]
FeatureScore = FB

[BasicDisplay_Inst.NT.Services]
AddService = BasicDisplay, 0x00000002, BasicDisplay_Service_Inst

[BasicDisplay_Service_Inst]
ServiceType    = 1
StartType      = 1
ErrorControl   = 0
ServiceBinary  = %12%\BasicDisplay.sys
LoadOrderGroup = Video

;-------------------------------- STRINGS -------------------------------

[Strings]
; Non-localizable
ReactOS = "ReactOS Project"

; Localizable
StdMfg = "(Standard system devices)"
BasicDisplay.DeviceDesc = "Basic Display Adapter"
