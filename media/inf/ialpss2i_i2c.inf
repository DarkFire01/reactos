; IALPSS2I_I2C.INF
;
; Intel LPSS gen-2 I2C controller.
;
; Intel used to ship one driver binary per SoC family, each with its own
; compiled-in SCL timing and a gate that refused silicon it was not built for.
; The newest one, iaLPSS2_I2C_WCL.sys, dropped both: it carries a single set of
; counts for every family and keys nothing off the PCI device id, leaving the
; registry and the firmware's SSCN, FMCN, FPCN and HSCN methods to adjust them
; per board. This driver follows that shape, so a part is listed here as soon
; as it is a gen-2 LPSS controller.
;
; The ids come from the PCI id database the tree already ships in
; hal/halx86/legacy/bus/pci_vendors.ids -- every Intel device it names as a
; Serial IO I2C controller from Sunrise Point through Meteor Lake. Five ids
; below (9DC6, 9DEA, 9DEB, 02C6, 02EB) are not in that database but sit inside
; a family's contiguous block and were already bound here.
;
; Still not listed:
;
;   iaLPSSi_I2C        Haswell / Broadwell, ACPI\INT33C2..INT3433 -- gen 1, a
;                      different register map, and enumerated through ACPI
;                      rather than PCI.
;   iaLPSS2i_I2C_BXT_P Apollo Lake, DEV_5AAC..5ABA
;   iaLPSS2i_I2C_GLK   Gemini Lake, DEV_31AC..31BA
;
; The two Atom families keep their own driver binaries in the reference with
; errata handling this one does not carry, so they stay out until that is read.

[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = System
ClassGUID  = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 09/02/2026,1.00

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%Intel% = Intel

[Intel]

; Sunrise Point / 100 and 200 Series
%iaLPSS2i_I2C.DeviceDesc% = iaLPSS2i_I2C_Device, PCI\VEN_8086&DEV_9D60
