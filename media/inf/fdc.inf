; floppy.INF

; Installation file for floppy disk controllers

[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = floppy
ClassGUID  = {4D36E969-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 08/15/2005,1.01.0.0

[DestinationDirs]
DefaultDestDir = 12

[ClassInstall32.NT]
AddReg = floppy.NT.AddReg

[floppy.NT.AddReg]
HKR, , ,               0, %floppyClassName%
HKR, , Icon,           0, "-9"
HKR,,NoInstallClass,,1

[Manufacturer]
%GenericMfg% = GenericMfg

[GenericMfg]
; The legacy floppy.sys is a non-PnP, System-start driver that claims the FDC
; directly from the firmware/BIOS hardware tree; it has no AddDevice and cannot
; act as the PnP function driver for the PNP0700 controller node (doing so makes
; the node fail with Code 39 "driver missing or damaged"). The PnP fdc.sys
; controller driver is not built (see drivers/storage/floppy/CMakeLists.txt), so
; install PNP0700 as needing no function driver - same pattern flpydisk.inf uses
; for the floppy drive node. Actual floppy I/O stays with the System-start
; floppy.sys service.
;%*PNP0700.DeviceDesc% = floppy_Inst,*PNP0700
%*PNP0700.DeviceDesc% = NO_DRV,*PNP0700

;----------------------------- floppy DRIVER -----------------------------

[floppy_Inst.NT]
CopyFiles = floppy_CopyFiles.NT

[floppy_CopyFiles.NT]
floppy.sys

[floppy_Inst.NT.Services]
AddService = floppy, 0x00000002, floppy_Service_Inst

[floppy_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\floppy.sys
LoadOrderGroup = System Bus Extender

;----------------------------- NO DRIVER REQ ----------------------------

[NO_DRV]

[NO_DRV.Services]
AddService = , 0x00000002

;-------------------------------- STRINGS -------------------------------

[Strings]
; Non-localizable
ReactOS = "ReactOS Project"

; Localizable
floppyClassName = "Floppy disk controllers"

GenericMfg = "(Generic floppy disk controllers)"
*PNP0700.DeviceDesc = "Generic floppy disk controller"

[Strings.0404]
floppyClassName = "軟碟控制器"

GenericMfg = "(標準軟碟控制器)"
*PNP0700.DeviceDesc = "標準軟碟控制器"

[Strings.0405]
floppyClassName = "Řadiče disketových jednotek"

GenericMfg = "(Generické řadiče disketových jednotek)"
*PNP0700.DeviceDesc = "Generický řadič disketové jednotky"

