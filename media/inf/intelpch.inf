; INTELPCH.INF
;
; Names the Intel chipset devices a modern PC enumerates, so that the dozen or
; so functions every PCH exposes are identified rather than sitting as unknown
; devices. Most need no driver at all: they are decoded by the chipset and the
; entry exists only to say what they are.
;
; Ported from the Intel Chipset Device Software package, which is a set of INFs
; of exactly this shape - a hardware id, a description, and a delegation to
; machine.inf. The reference reaches machine.inf with Include/Needs; the
; sections are repeated here instead, because setupapi in this tree discards
; what a Needs directive reports and a silently skipped section would leave a
; device half-installed.
;
; The three outcomes mirror the reference:
;
;   NO_DRV        the function needs no driver
;   PCI_Inst      a PCI-to-PCI bridge, enumerated by pci.sys
;   PCI_ISA_Inst  an LPC/ISA bridge, enumerated by isapnp
;
; Covers Sandy Bridge through Kaby Lake and Apollo Lake. Later parts are absent
; because the reference package predates them: an id belongs here only with the
; description Intel gave it, not one invented to fill the gap.

[Version]
Signature  = "$Windows NT$"
Class      = System
ClassGUID  = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 09/05/2026,1.00

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%Intel% = Intel

[Intel]
%PCI_VEN_8086&DEV_0100.DeviceDesc% = NO_DRV,PCI\VEN_8086&DEV_0100
