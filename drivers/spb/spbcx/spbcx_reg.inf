; Simple Peripheral Bus class extension
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","Group",0x00000000,"Boot Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","ImagePath",0x00020000,"system32\drivers\spbcx.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","Type",0x00010001,0x00000001

; KMDF class extension registration
HKLM,"System\CurrentControlSet\Control\Wdf\Kmdf\SPBCx\Versions\1\1","Service",0x00000000,"spbcx"
