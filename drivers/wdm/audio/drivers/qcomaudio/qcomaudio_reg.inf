; Qualcomm audio speaker on \_SB.ARPD, the audio RPC node no Windows driver claims here.
; PortCls publishes the render and topology filters on it.
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\qcomaudio","DisplayName",0x00000000,"Qualcomm Audio Speaker"
HKLM,"SYSTEM\CurrentControlSet\Services\qcomaudio","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\qcomaudio","ImagePath",0x00020000,"system32\drivers\qcomaudio.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\qcomaudio","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\qcomaudio","Type",0x00010001,0x00000001

HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96C-E325-11CE-BFC1-08002BE10318}","",0x00000000,"Sound, video and game controllers"
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96C-E325-11CE-BFC1-08002BE10318}","Class",0x00000000,"MEDIA"
