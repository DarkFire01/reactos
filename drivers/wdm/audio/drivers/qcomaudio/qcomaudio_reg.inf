HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96C-E325-11CE-BFC1-08002BE10318}\0000","ProviderName",0x00000000,"ReactOS"
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96C-E325-11CE-BFC1-08002BE10318}\0000","MatchingDeviceId",0x00000000,"acpi\qcom02f3"

HKLM,"SYSTEM\CurrentControlSet\Enum\ACPI\QCOM02F3\_SB_ARPD","DeviceDesc",0x00000000,"Qualcomm Audio Speaker"
