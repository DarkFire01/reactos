; What the media class installer (mmsys.cpl) sets up when a sound device installs:
; the system audio services, AudioSrv on auto start, and wdmaud as the wave driver
HKLM,"SYSTEM\CurrentControlSet\Services\sysaudio","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\sysaudio","ImagePath",0x00020000,"system32\drivers\sysaudio.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\sysaudio","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\sysaudio","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\wdmaud","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\wdmaud","ImagePath",0x00020000,"system32\drivers\wdmaud.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\wdmaud","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\wdmaud","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\kmixer","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\kmixer","ImagePath",0x00020000,"system32\drivers\kmixer.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\kmixer","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\kmixer","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\AudioSrv","Start",0x00010001,0x00000002
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Drivers32","wave1",0x00000000,"wdmaud.drv"
