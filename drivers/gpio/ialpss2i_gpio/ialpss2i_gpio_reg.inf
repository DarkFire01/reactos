; Intel LPSS GPIO controller
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\ialpss2i_gpio","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\ialpss2i_gpio","Group",0x00000000,"Extended Base"
HKLM,"SYSTEM\CurrentControlSet\Services\ialpss2i_gpio","ImagePath",0x00020000,"system32\drivers\ialpss2i_gpio.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\ialpss2i_gpio","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\ialpss2i_gpio","Type",0x00010001,0x00000001

; Critical devices, so the controller starts at boot without an INF install
