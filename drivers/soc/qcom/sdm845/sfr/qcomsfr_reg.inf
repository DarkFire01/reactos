; DIAG: shared memory failure reason watcher
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\qcomsfr","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\qcomsfr","ImagePath",0x00020000,"system32\drivers\qcomsfr.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\qcomsfr","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\qcomsfr","Type",0x00010001,0x00000001
