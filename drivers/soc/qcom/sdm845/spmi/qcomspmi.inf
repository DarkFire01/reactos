; QCOMSPMI.INF

; Installation file for the SPMI PMIC arbiter of Qualcomm SDM845

[Version]
Signature = "$Windows NT$"
Class = System
ClassGuid = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider = %ReactOS%
DriverVer = 11/11/2026,1.00

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
qcomspmi.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%Mfg% = Mfg

[Mfg]
%QCOMSPMI.DeviceDesc% = QCOMSPMI_Device, ACPI\QCOM0216

[QCOMSPMI_Device.NT]
CopyFiles = QCOMSPMI_CopyFiles

[QCOMSPMI_CopyFiles]
qcomspmi.sys

[QCOMSPMI_Device.NT.Services]
AddService = qcomspmi, 0x00000002, QCOMSPMI_Service

[QCOMSPMI_Service]
DisplayName    = %QCOMSPMI.ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\qcomspmi.sys
LoadOrderGroup = System Bus Extender

[Strings]
ReactOS = "ReactOS Project"
Mfg = "Qualcomm"
DiskId1 = "ReactOS Installation Disk"
QCOMSPMI.DeviceDesc = "Qualcomm SPMI PMIC Arbiter"
QCOMSPMI.ServiceDesc = "Qualcomm SPMI Arbiter"
