; Qualcomm GENI Serial Engine
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\qcomgeni","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\qcomgeni","Group",0x00000000,"System Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\qcomgeni","ImagePath",0x00020000,"system32\drivers\qcomgeni.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\qcomgeni","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\qcomgeni","Type",0x00010001,0x00000001
