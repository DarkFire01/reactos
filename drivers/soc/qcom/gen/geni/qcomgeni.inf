; QCOMGENI.INF

; Installation file for the GENI serial engine I2C controllers of Qualcomm SoCs

[Version]
Signature = "$Windows NT$"
Class = System
ClassGuid = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider = %ReactOS%
DriverVer = 11/11/2026,1.00

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
qcomgeni.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%Mfg% = Mfg

[Mfg]
%QCOMGENI.DeviceDesc% = QCOMGENI_Device, ACPI\QCOM0220

[QCOMGENI_Device.NT]
CopyFiles = QCOMGENI_CopyFiles

[QCOMGENI_CopyFiles]
qcomgeni.sys

[QCOMGENI_Device.NT.Services]
AddService = qcomgeni, 0x00000002, QCOMGENI_Service

[QCOMGENI_Service]
DisplayName    = %QCOMGENI.ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\qcomgeni.sys
LoadOrderGroup = System Bus Extender

[Strings]
ReactOS = "ReactOS Project"
Mfg = "Qualcomm"
DiskId1 = "ReactOS Installation Disk"
QCOMGENI.DeviceDesc = "Qualcomm GENI I2C Controller"
QCOMGENI.ServiceDesc = "Qualcomm GENI Serial Engine"
