#include "duiframe_res.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDR_DUISHELLVIEWFRAME REGISTRY "res/rgs/duishellviewframe.rgs"
IDR_COMMONLAYOUTDEFINITION REGISTRY "res/rgs/commonlayoutdefinition.rgs"
IDR_COMMONLAYOUTMODIFIER REGISTRY "res/rgs/commonlayoutmodifier.rgs"

/* Folder layouts, picked by layout type */
3  UIFILE "duiframe/res/layout3.uixml"
4  UIFILE "duiframe/res/layout4.uixml"
5  UIFILE "duiframe/res/layout5.uixml"
6  UIFILE "duiframe/res/layout6.uixml"
10 UIFILE "duiframe/res/layout10.uixml"
13 UIFILE "duiframe/res/layout13.uixml"
14 UIFILE "duiframe/res/layout14.uixml"
15 UIFILE "duiframe/res/layout15.uixml"
16 UIFILE "duiframe/res/layout16.uixml"
17 UIFILE "duiframe/res/layout17.uixml"
18 UIFILE "duiframe/res/layout18.uixml"
19 UIFILE "duiframe/res/layout19.uixml"
20 UIFILE "duiframe/res/layout20.uixml"
21 UIFILE "duiframe/res/layout21.uixml"
31 UIFILE "duiframe/res/layout31.uixml"
53 UIFILE "duiframe/res/layout53.uixml"
54 UIFILE "duiframe/res/layout54.uixml"
56 UIFILE "duiframe/res/layout56.uixml"
57 UIFILE "duiframe/res/layout57.uixml"
58 UIFILE "duiframe/res/layout58.uixml"
62 UIFILE "duiframe/res/layout62.uixml"

/* Frame chrome the layout modifier merges in front of the folder layout */
11 UIFILE "duiframe/res/layout11.uixml"
12 UIFILE "duiframe/res/layout12.uixml"
27 UIFILE "duiframe/res/layout27.uixml"
28 UIFILE "duiframe/res/layout28.uixml"
46 UIFILE "duiframe/res/layout46.uixml"
49 UIFILE "duiframe/res/layout49.uixml"

/* Markup of the frame modules' inner elements */
32 UIFILE "duiframe/res/folderband.uixml"
52 UIFILE "duiframe/res/propertree.uixml"

/* Preview pane button of the command bar: pane closed, pane open */
16757 ICON "duiframe/res/previewshow.ico"
16758 ICON "duiframe/res/previewhide.ico"

/* Nav pane tree shortcuts */
5 ACCELERATORS
BEGIN
    "X", 0xA041, VIRTKEY, CONTROL, NOINVERT
    "C", 0xA042, VIRTKEY, CONTROL, NOINVERT
    "V", 0xA043, VIRTKEY, CONTROL, NOINVERT
    VK_F2, 0xA024, VIRTKEY, NOINVERT
    VK_INSERT, 0xA042, VIRTKEY, CONTROL, NOINVERT
    VK_INSERT, 0xA043, VIRTKEY, SHIFT, NOINVERT
    VK_DELETE, 0xA023, VIRTKEY, NOINVERT
    VK_DELETE, 0xA023, VIRTKEY, SHIFT, NOINVERT
    "D", 0xA023, VIRTKEY, CONTROL, NOINVERT
    VK_RETURN, 0xA025, VIRTKEY, ALT, NOINVERT
    VK_F5, 0xA220, VIRTKEY, NOINVERT
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* Nav pane options on the empty area of the tree */
275 MENUEX
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Show &all folders", 0
        MENUITEM "Expand to &current folder", 1
    END
END

IDM_PREVIEWPANE MENUEX
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Size", IDC_PREVIEW_SIZE
        BEGIN
            MENUITEM "&Small", IDC_PREVIEW_SIZE_SMALL
            MENUITEM "&Medium", IDC_PREVIEW_SIZE_MEDIUM
            MENUITEM "&Large", IDC_PREVIEW_SIZE_LARGE
        END
        MENUITEM "", -1, MFT_SEPARATOR
        MENUITEM "&Remove properties...", IDC_PREVIEW_REMOVEPROPS
    END
END

STRINGTABLE
BEGIN
    IDS_DUI_SHELLFOLDERVIEW "Shell Folder View"
