<duixml>
<Element resid="PreviewEditMetadata" id="atom(PreviewEditMetadata)" layout="flowlayout(0, 2, 1, 2)">
<CCPushButton minsize="size(90rp, 12rp)" padding="rect(0, 0, 10rp, 0)" id="atom(PreviewSaveMetadata)" content="resstr(0x9563, library(shell32.dll))" accessible="true" accrole="pushbutton"/>
<CCPushButton minsize="size(90rp, 12rp)" id="atom(PreviewCancelMetadata)" content="resstr(0x9564, library(shell32.dll))" accessible="true" accrole="pushbutton"/>
</Element>
<Element resid="PreviewForceLoadMetadataContainer" id="atom(PreviewForceLoadMetadataContainer)" layout="flowlayout(0, 2, 0, 2)">
<Button content="resstr(0x9560, library(shell32.dll))" id="atom(PreviewForceLoadMetadata)" accessible="true" accrole="pushbutton"/>
</Element>
<Element resid="PreviewMetadataSpacer" id="atom(PreviewMetadataSpacer)"/>
<Element resid="PreviewItemCountTitle" layout="borderlayout()">
<MetadataLabel layoutpos="Left" id="atom(ItemCountLabel)" active="inactive"/>
</Element>
<Element resid="PreviewMetadataTitle" layout="borderlayout()">
<MetadataElement layoutpos="Left" id="atom(PreviewMetadataTitleControl)" layout="borderlayout()"/>
</Element>
<Element resid="PreviewMetadataSubTitle" layout="borderlayout()">
<MetadataElement layoutpos="Left" id="atom(PreviewMetadataSubTitleControl)" layout="borderlayout()"/>
</Element>
<Element resid="PreviewMetadataRow" id="atom(PreviewMetadataRow)" accessible="true" accname="resstr(0x9555, library(shell32.dll))" accrole="grouping" layout="borderlayout()">
<MetadataLabel layoutpos="Left" id="atom(PreviewMetadataLabel)" active="inactive"/>
<MetadataElement layoutpos="Left" id="atom(PreviewMetadataControl)" layout="borderlayout()"/>
</Element>
<Element resid="PreviewMetadata"/>
</duixml>
