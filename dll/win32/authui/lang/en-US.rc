LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_SHUTDOWN "Shut down"
    IDS_SHUTDOWN_MENU "Sh&ut down"
    IDS_SHUTDOWN_DESC "Closes all open programs, shuts down ReactOS, and then turns off your computer."
    IDS_RESTART "Restart"
    IDS_RESTART_MENU "&Restart"
    IDS_RESTART_DESC "Closes all open programs, shuts down ReactOS, and then starts ReactOS again."
    IDS_SLEEP "Sleep"
    IDS_SLEEP_MENU "&Sleep"
    IDS_SLEEP_DESC "Keeps your session in memory and puts the computer in a low-power state so that you can quickly resume working."
    IDS_HIBERNATE "Hibernate"
    IDS_HIBERNATE_MENU "&Hibernate"
    IDS_HIBERNATE_DESC "Saves your session and turns off the computer. When you turn on the computer, ReactOS restores your session."
    IDS_UPDATESHUTDOWN "Install updates and shut down"
    IDS_UPDATESHUTDOWN_MENU "Install u&pdates and shut down"
    IDS_UPDATESHUTDOWN_DESC "Installs updates, closes all open programs, shuts down ReactOS, and then turns off your computer."
    IDS_UPDATERESTART "Install updates and restart"
    IDS_UPDATERESTART_MENU "Install upd&ates and restart"
    IDS_UPDATERESTART_DESC "Installs updates, closes all open programs, shuts down ReactOS, and then starts ReactOS again."
    IDS_LOGOFF "Log off"
    IDS_LOGOFF_MENU "&Log off"
    IDS_LOGOFF_DESC "Closes your programs and logs you off."
    IDS_DISCONNECT "Disconnect"
    IDS_DISCONNECT_MENU "&Disconnect"
    IDS_DISCONNECT_DESC "Ends your connection to this remote computer."
    IDS_LOCK "Lock"
    IDS_LOCK_MENU "L&ock"
    IDS_LOCK_DESC "Locks this computer."
    IDS_UNDOCK "Undock"
    IDS_UNDOCK_MENU "U&ndock"
    IDS_UNDOCK_DESC "Removes your laptop or notebook computer from a docking station."
    IDS_DISABLED_DESC "The system administrator has disabled this option for your user account."
    IDS_SWITCHUSER "Switch user"
    IDS_SWITCHUSER_MENU "S&witch user"
    IDS_SWITCHUSER_DESC "Switch users without closing programs."
END
