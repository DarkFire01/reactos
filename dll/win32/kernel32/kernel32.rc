#define REACTOS_VERSION_DLL
#define REACTOS_STR_FILE_DESCRIPTION  "W32 subsystem kernel"
#define REACTOS_STR_INTERNAL_NAME     "kernel32"
#define REACTOS_STR_ORIGINAL_FILENAME "kernel32.dll"

/*
 * kernel32's version resource is read as the version of the system itself,
 * and deliberately so: an application that wants the real version rather
 * than whatever a compatibility shim is telling it reads this, because a
 * shim cannot reach the file on disk. Chromium does exactly that, and so
 * does anything else that wants to see past AppCompat.
 *
 * The ordinary ReactOS file version is no use for that. It is the kernel
 * version with 42 added to the major (see REACTOS_DLL_VERSION_MAJOR in
 * sdk/include/reactos/version.cmake), which exists so that an application
 * checking whether a DLL is new enough is satisfied. Read as an OS version
 * it says 42.4.17, which is not a Windows that ever shipped, and a caller
 * that parses it either gives up or picks something arbitrary.
 *
 * So this one module states the version the system reports elsewhere:
 * Windows 10 22H2, build 19045. Everything else keeps the ReactOS version.
 */
#define REACTOS_FILEVERSION         10,0,19045,3803
#define REACTOS_STR_FILE_VERSION    "10.0.19045.3803"

#include <reactos/version.rc>

//#include "windows.h"
#include <errcodes.rc>

