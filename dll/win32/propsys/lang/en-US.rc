    IDS_SORT_A_Z "A to Z"
    IDS_SORT_Z_A "Z to A"
    IDS_SORT_LOW_HIGH "Lowest to highest"
    IDS_SORT_HIGH_LOW "Highest to lowest"
    IDS_SORT_SMALL_BIG "Smallest to largest"
    IDS_SORT_BIG_SMALL "Largest to smallest"
    IDS_SORT_OLD_NEW "Oldest to newest"
    IDS_SORT_NEW_OLD "Newest to oldest"
    IDS_SORT_ASCENDING "Ascending"
    IDS_SORT_DESCENDING "Descending"
    IDS_DATE_RANGE "%1 - %2"
END

