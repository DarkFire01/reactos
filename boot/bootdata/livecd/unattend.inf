[Unattend]
Signature = "$ReactOS$"

; Set UnattendSetupEnabled to yes in order to immediately start the ReactOS installer.
; yes - unattend setup enabled
; no - unattend setup disabled
UnattendSetupEnabled = no

; Set this option to automatically specify language in the language setup.
; See hivesys.inf for available languages.
LocaleID = 409

; Default visual style; set DefaultThemesOff = yes for the classic theme.
[Shell]
DefaultThemesOff = no
CustomDefaultThemeFile = "%WINDIR%\Resources\Themes\Horizon\Horizon.msstyles"
