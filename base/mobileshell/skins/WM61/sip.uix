        </Element>
        <Element Width="*" Command="sip.char:3" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
