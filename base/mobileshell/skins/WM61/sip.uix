        <Element Width="*" Command="sip.char:5" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
          <Text Content="{K.5}" TextAlign="Center"/>
        </Element>
        <Element Width="*" Command="sip.char:6" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
          <Text Content="{K.6}" TextAlign="Center"/>
        </Element>
        <Element Width="*" Command="sip.char:7" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
