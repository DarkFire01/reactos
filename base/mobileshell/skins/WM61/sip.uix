<?xml version="1.0" encoding="utf-8"?>
<!-- Soft input panel, owned by MobileUI. The WM Keyboard input method layout, generated once, edit freely. -->
<Uix Name="Sip">
  <Element Name="SipRoot" Visible="false">
    <Element Name="SipPanel" Layer="true" VAlign="Bottom" Margin="0,0,0,@SoftKeyHeight" Layout="Stack"
             Background="@SipBackground" BorderBrush="@SipKeyBorder" BorderThickness="1,1,0,0"
             Foreground="@SipText" Font="@SipFont" Reveal="0,12,0.1">
    <Element Name="SipLetters" Layout="Stack">
      <Element Layout="Row" Height="@SipKeyHeight">
        <Element Width="1.3*" Command="sip.123" Background="{SymbolsFill}" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
          <Text Content="123" TextAlign="Center"/>
        </Element>
        <Element Width="*" Command="sip.char:1" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
          <Text Content="{K.1}" TextAlign="Center"/>
        </Element>
        <Element Width="*" Command="sip.char:2" Background="@SipKey" BorderBrush="@SipKeyBorder" BorderThickness="0,0,1,1" Momentary="true" SelectedBackground="@SipKeyPressed" SelectedForeground="@SipKeyPressedText">
