<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar app: Month view with the selected day's list, Agenda view, appointment editor. -->
<Uix Name="Calendar" Background="@AppBackground" Layout="Stack" Foreground="@AppText" Font="@Default">

  <Element Name="PageMonth" Layout="Stack" Height="*">
    <Element Layout="Row" Height="22" Background="@CalHeader" BorderBrush="@ListSeparator" BorderThickness="0,0,0,1">
      <Element Width="26" Command="month:-1" Momentary="true" SelectedBackground="@ItemSelected">
        <Text Content="&#xE76B;" Font="@StatusGlyph" TextAlign="Center"/>
      </Element>
      <Text Content="{MonthTitle}" Font="@ItemBold" TextAlign="Center" Width="*"/>
      <Element Width="26" Command="month:1" Momentary="true" SelectedBackground="@ItemSelected">
        <Text Content="&#xE76C;" Font="@StatusGlyph" TextAlign="Center"/>
      </Element>
    </Element>

    <Element Layout="Row" Height="15" Font="@SmallFont" Foreground="@AppSubText" Padding="1,0,1,0">
      <Text Content="S" TextAlign="Center" Width="*"/>
      <Text Content="M" TextAlign="Center" Width="*"/>
      <Text Content="T" TextAlign="Center" Width="*"/>
      <Text Content="W" TextAlign="Center" Width="*"/>
      <Text Content="T" TextAlign="Center" Width="*"/>
      <Text Content="F" TextAlign="Center" Width="*"/>
      <Text Content="S" TextAlign="Center" Width="*"/>
    </Element>

    <Repeater Name="Days" Layout="Wrap" Padding="1,0,1,0" BorderBrush="@DayGrid" BorderThickness="0,1,0,0">
      <Element Width="@DayCellWidth" Height="@DayCellHeight" Layout="Stack" Command="day:{Item.Date}"
               Background="{Item.Fill}" BorderBrush="@DayGrid" BorderThickness="0,0,1,1">
        <Text Content="{Item.Day}" Foreground="{Item.Ink}" TextAlign="Center" Height="*"/>
        <Element Height="3" Margin="10,0,10,2" Background="{Item.Mark}"/>
      </Element>
    </Repeater>

    <Text Content="{DayTitle}" Font="@ItemBold" Padding="4,3,4,2" Background="@CalHeader"
          BorderBrush="@ListSeparator" BorderThickness="0,1,0,1"/>
    <Element Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@ScrollTrack" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="5">
      <Repeater Name="DayItems" Layout="Stack">
        <Element Layout="Row" Height="18" Padding="4,0,8,0" Command="appt:{Item.Id}" HoldCommand="apptmenu:{Item.Id}"
                 Selectable="true" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText">
          <Text Content="{Item.Time}" Font="@ItemBold" Width="40"/>
          <Text Content="{Item.Subject}" Width="*"/>
        </Element>
      </Repeater>
      <Text Name="DayEmpty" Content="No appointments" Foreground="@AppSubText" Padding="6,4,6,4" Visible="false"/>
    </Element>
  </Element>

  <Element Name="PageAgenda" Layout="Stack" Height="*" Visible="false">
    <Text Content="Agenda" Font="@ItemBold" Padding="4,3,4,2" Background="@CalHeader" BorderBrush="@ListSeparator" BorderThickness="0,0,0,1"/>
    <Element Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@ScrollTrack" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="5">
      <Repeater Name="AgendaItems" Layout="Stack">
        <Element Layout="Stack" Command="appt:{Item.Id}" HoldCommand="apptmenu:{Item.Id}" Selectable="true"
                 SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText">
          <Text Content="{Item.Header}" Collapse="true" Font="@ItemBold" Foreground="@AppHeaderText" Padding="4,4,4,1"/>
          <Element Layout="Row" Height="18" Padding="12,0,8,0">
            <Text Content="{Item.Time}" Width="40"/>
            <Text Content="{Item.Subject}" Width="*"/>
          </Element>
        </Element>
      </Repeater>
      <Text Name="AgendaEmpty" Content="No upcoming appointments" Foreground="@AppSubText" Padding="6,6,6,6" Visible="false"/>
    </Element>
  </Element>

  <Element Name="PageEdit" Layout="Stack" Height="*" Padding="6,4,6,4" Visible="false">
    <Text Content="New Appointment" Font="@AppHeaderFont" Foreground="@AppHeaderText" Margin="0,0,0,6"/>
    <Text Content="Subject:" Font="@SmallFont" Foreground="@AppSubText"/>
    <Element Height="20" Command="edit.subject" Background="@FieldActive" BorderBrush="@FieldBorder" BorderThickness="1" Padding="3,0,3,0" Margin="0,1,0,6">
      <Text Content="{EditSubject}"/>
    </Element>
    <Text Content="Date:" Font="@SmallFont" Foreground="@AppSubText"/>
    <Element Layout="Row" Height="20" Margin="0,1,0,6">
      <Element Width="22" Command="edit.day:-1" Momentary="true" Background="@ButtonFace" BorderBrush="@ButtonBorder" BorderThickness="1" SelectedBackground="@ItemSelected">
        <Text Content="&#xE76B;" Font="@StatusGlyph" TextAlign="Center"/>
      </Element>
      <Text Content="{EditDate}" TextAlign="Center" Width="*"/>
      <Element Width="22" Command="edit.day:1" Momentary="true" Background="@ButtonFace" BorderBrush="@ButtonBorder" BorderThickness="1" SelectedBackground="@ItemSelected">
        <Text Content="&#xE76C;" Font="@StatusGlyph" TextAlign="Center"/>
      </Element>
    </Element>
    <Text Content="Starts:" Font="@SmallFont" Foreground="@AppSubText"/>
    <Element Layout="Row" Height="20" Margin="0,1,0,6">
      <Element Width="22" Command="edit.time:-30" Momentary="true" Background="@ButtonFace" BorderBrush="@ButtonBorder" BorderThickness="1" SelectedBackground="@ItemSelected">
        <Text Content="-" Font="@ItemBold" TextAlign="Center"/>
      </Element>
      <Text Content="{EditTime}" TextAlign="Center" Width="*"/>
      <Element Width="22" Command="edit.time:30" Momentary="true" Background="@ButtonFace" BorderBrush="@ButtonBorder" BorderThickness="1" SelectedBackground="@ItemSelected">
        <Text Content="+" Font="@ItemBold" TextAlign="Center"/>
      </Element>
    </Element>
  </Element>

</Uix>
