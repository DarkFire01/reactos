<?xml version="1.0" encoding="utf-8"?>
<!-- Sheets Mobile, part of ReactOS Office Mobile (office.exe). Formulas: + - * / ^, SUM AVERAGE MIN MAX COUNT. -->
<Uix Name="Sheets" Mode="Sheets" Background="@AppBackground" Layout="Stack" Foreground="@AppText" Font="@Default">
  <Element Name="PageList" Layout="Stack" Height="*">
    <Element Layout="Row" Height="23" Padding="3,3,3,2">
      <Element Width="*" Command="find.focus" Background="@FieldNormal" BorderBrush="@FieldBorder" BorderThickness="1" Padding="3,0,3,0">
        <Text Name="FindHint" Content="Find a workbook..." Font="@SmallItalic" Foreground="@AppSubText"/>
        <Text Content="{FindText}"/>
      </Element>
      <Element Width="20" Command="find.clear" Momentary="true" Margin="2,0,0,0" SelectedBackground="@ItemSelected">
        <Text Content="&#xE711;" Font="@StatusGlyph" TextAlign="Center" Foreground="@AppSubText"/>
      </Element>
    </Element>
    <Element Layout="Row" Height="16" Background="@IndexBar" Padding="5,0,6,0" Font="@SmallFont" BorderBrush="@ListSeparator" BorderThickness="0,1,0,1">
      <Text Content="{ListHeader}" Width="*" Font="@ItemBold"/>
      <Text Content="{SortLabel}" Foreground="@AppSubText"/>
    </Element>
    <Element Name="ListScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@ScrollTrack" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="5">
      <Repeater Name="Docs" Layout="Stack">
        <Element Name="d{Item.Id}" Layout="Row" Height="@ListItemHeight" Padding="4,1,9,1" BorderBrush="@ListSeparator" BorderThickness="0,0,0,1"
                 Command="open:{Item.Id}" HoldCommand="hold:{Item.Id}" Selectable="true"
                 SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText">
          <Image Source="@Icon.Excel" Width="18" Height="18" VAlign="Center" Margin="0,0,6,0"/>
          <Element Layout="Stack" Width="*">
            <Text Content="{Item.Name}" Font="@ItemBold" Height="*"/>
            <Text Content="{Item.Detail}" Font="@SmallFont" Foreground="@AppSubText" Height="*"/>
          </Element>
        </Element>
      </Repeater>
      <Text Name="ListEmpty" Content="No documents found." TextAlign="Center" Margin="0,24,0,0" Foreground="@AppSubText" Visible="false"/>
    </Element>
  </Element>
  <Element Name="PageSheet" Layout="Stack" Height="*" Visible="false" Font="@SmallFont">
    <Element Layout="Row" Height="20" BorderBrush="@FieldBorder" BorderThickness="0,0,0,1">
      <Text Content="{CellRef}" Width="30" TextAlign="Center" Font="@ItemBold" Background="@IndexBar"/>
      <Element Width="*" Background="@FieldActive" Padding="4,0,4,0">
        <Text Content="{CellEdit}" Font="@Default"/>
      </Element>
    </Element>
    <Element Layout="Row" Height="15" Background="@IndexBar" BorderBrush="@DayGrid" BorderThickness="0,0,0,1">
      <Element Width="@SheetHeaderWidth"/>
      <Text Content="A" Width="@SheetCellWidth" TextAlign="Center" Font="@ItemBold"/>
      <Text Content="B" Width="@SheetCellWidth" TextAlign="Center" Font="@ItemBold"/>
      <Text Content="C" Width="@SheetCellWidth" TextAlign="Center" Font="@ItemBold"/>
      <Text Content="D" Width="@SheetCellWidth" TextAlign="Center" Font="@ItemBold"/>
      <Text Content="E" Width="@SheetCellWidth" TextAlign="Center" Font="@ItemBold"/>
    </Element>
    <Element Name="SheetScroll" Scroll="true" Height="*" ScrollBarBrush="@ScrollTrack" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="4">
      <Repeater Name="Cells" Layout="Wrap">
        <Element Name="{Item.Id}" Width="{Item.W}" Height="@SheetRowHeight" Background="{Item.Fill}" Command="{Item.Command}"
                 Selectable="true" SelectedBackground="@CellSelected" SelectedForeground="@ItemSelectedText"
                 BorderBrush="@DayGrid" BorderThickness="0,0,1,1" Padding="2,0,2,0">
          <Text Content="{Item.Text}" TextAlign="{Item.Align}"/>
        </Element>
      </Repeater>
    </Element>
  </Element>
</Uix>