<?xml version="1.0" encoding="utf-8"?>
<!-- Action center, owned by MobileUI. Pulled from the status bar: quick actions, volume, details, handle bar. -->
<Uix Name="Status">
  <Element Name="StatusRoot" Visible="false">

    <Element Command="status.close" Momentary="true" Background="@ToastScrim" Margin="0,@TrayHeight,0,0"/>

    <Element Name="StatusPanel" Layer="true" Y="@TrayHeight" VAlign="Top" Layout="Stack"
             Background="@PanelBackground" Foreground="@BaseHigh" Font="@Body"
             Reveal="0,-120,0.3,0" SwipeLeft="status.close" SwipeRight="status.close">

      <!-- Quick actions: 60 high, 4 apart, icon top left, caption bottom left -->
      <Element Layout="Row" Height="60" Margin="4,20,4,4" Font="@Caption">
        <Element Width="*" Margin="0,0,4,0" Layout="Stack" Background="@ActionOn" Foreground="@BaseWhite"
                 Command="launch:WiFi" Momentary="true" SelectedBackground="@AccentDim">
          <Text Content="&#xE701;" Font="@Glyph16" Margin="4,4,0,0" Height="*"/>
          <Text Content="Wi-Fi" Margin="4,0,0,6"/>
        </Element>
        <Element Width="*" Margin="0,0,4,0" Layout="Stack" Background="@ActionOff"
                 Command="volume.mute" Momentary="true" SelectedBackground="@BaseMidLow">
          <Text Content="{VolumeGlyph}" Font="@Glyph16" Margin="4,4,0,0" Height="*"/>
          <Text Content="{MuteLabel}" Margin="4,0,0,6"/>
        </Element>
        <Element Width="*" Margin="0,0,4,0" Layout="Stack" Background="@ActionOff"
                 Command="launch:Power" Momentary="true" SelectedBackground="@BaseMidLow">
          <Text Content="&#xE83F;" Font="@Glyph16" Margin="4,4,0,0" Height="*"/>
          <Text Content="Battery saver" Margin="4,0,0,6"/>
        </Element>
        <Element Width="*" Layout="Stack" Background="@ActionOff"
                 Command="launch:Settings" Momentary="true" SelectedBackground="@BaseMidLow">
          <Text Content="&#xE713;" Font="@Glyph16" Margin="4,4,0,0" Height="*"/>
          <Text Content="All settings" Margin="4,0,0,6"/>
        </Element>
      </Element>

      <!-- Volume as a slider track: 2 high, accent fill -->
      <Element Layout="Row" Height="44" Padding="12,0,0,0">
        <Text Content="{StatusVolume}" Width="*" TextVAlign="Center"/>
        <Element Width="44" Command="volume.down" Momentary="true" SelectedBackground="@ListPress">
          <Text Content="&#xE738;" Font="@Glyph16" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Element Width="44" Command="volume.up" Momentary="true" SelectedBackground="@ListPress">
          <Text Content="&#xE710;" Font="@Glyph16" TextAlign="Center" TextVAlign="Center"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="2" Margin="12,0,12,12">
        <Element Width="*" Background="{Vol1}"/>
        <Element Width="*" Background="{Vol2}"/>
        <Element Width="*" Background="{Vol3}"/>
        <Element Width="*" Background="{Vol4}"/>
        <Element Width="*" Background="{Vol5}"/>
        <Element Width="*" Background="{Vol6}"/>
        <Element Width="*" Background="{Vol7}"/>
        <Element Width="*" Background="{Vol8}"/>
        <Element Width="*" Background="{Vol9}"/>
        <Element Width="*" Background="{Vol10}"/>
      </Element>

      <!-- Connection and battery -->
      <Element Layout="Row" Height="44" Padding="12,0,12,0" Command="launch:WiFi" Momentary="true" SelectedBackground="@ListPress">
        <Text Content="{StatusNetwork}" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="44" Padding="12,0,12,0" Command="launch:Power" Momentary="true" SelectedBackground="@ListPress">
        <Text Content="{StatusBattery}" Width="*" TextVAlign="Center"/>
      </Element>

      <Element Layout="Row" Height="48" Padding="12,0,12,0" Command="notify.show" Momentary="true" SelectedBackground="@ListPress">
        <Text Content="No new notifications" Foreground="@BaseMid" Width="*" TextVAlign="Center"/>
      </Element>

      <!-- Handle bar -->
      <Element Height="16" Background="@Accent" Command="status.close" Momentary="true">
        <Text Content="&#xE76F;" Font="@Glyph16" Foreground="@BaseWhite" TextAlign="Center" TextVAlign="Center"/>
      </Element>
    </Element>

  </Element>
</Uix>
