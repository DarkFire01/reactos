<?xml version="1.0" encoding="utf-8"?>
<!-- All apps, owned by MobileUI. Opens from Start with a left swipe or All apps; swipe right or Back returns. -->
<Uix Name="StartMenu">
  <Element Name="StartMenuRoot" Visible="false">

    <Element Name="AppList" Layer="true" Margin="0,@TrayHeight,0,@NavBarHeight" Background="@StartBackground"
             Foreground="@BaseHigh" Font="@Body" Reveal="60,0,0.3,0" SwipeRight="start.dismiss">
      <Element Scroll="true" Layout="Stack" ScrollBarWidth="0" Padding="0,8,0,8">
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="A" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:ClockSettings" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE823;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Alarms &amp; Clock" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="C" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Calculator" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE8EF;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Calculator" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Calendar" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE787;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Calendar" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="F" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Files" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xEC50;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="File Explorer" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="G" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Help" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE82F;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Getting Started" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="M" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Messaging" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE8BD;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Messaging" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="N" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Notes" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE70B;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Notes Mobile" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="O" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Office" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE8A5;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Office Mobile" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="P" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Contacts" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE716;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="People" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="S" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Settings" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE713;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Settings" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Sheets" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE80A;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Sheets Mobile" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Slides" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE7F4;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Slides Mobile" Width="*" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11">
        <Element Width="@AppIcon" BorderBrush="@Accent" BorderThickness="2">
          <Text Content="W" Font="@Subtitle" Foreground="@BaseHigh" Padding="5,0,0,1" TextVAlign="Bottom"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Writer" Selectable="true" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xE8A5;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Text Content="Writer Mobile" Width="*" TextVAlign="Center"/>
      </Element>
      </Element>
    </Element>

  </Element>
</Uix>
