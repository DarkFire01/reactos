<?xml version="1.0" encoding="utf-8"?>
<!-- Programs list, hosted by MarkupApp. Each row is a launch:<AppId> command, so remap here. -->
<Uix Name="Programs" Title="Programs" Close="ok" Background="@AppBackground" Layout="Stack" Foreground="@AppText" Font="@Default">
  <Text Content="PROGRAMS" Font="@BaseFont" Padding="12,12,12,8"/>
  <Element Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Games" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE7FC;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Games" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:ActiveSync" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE895;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Sync" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Calculator" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE8EF;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Calculator" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Calendar" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE787;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Calendar" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Camera" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE722;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Camera" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Contacts" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE716;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
