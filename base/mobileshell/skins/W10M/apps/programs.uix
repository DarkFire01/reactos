      <Text Content="People" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:DeviceManager" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE772;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Device Manager" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Files" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE8B7;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
