    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Tasks" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE762;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Tasks" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:MediaPlayer" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
