    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Solitaire" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="@AppIcon" Background="@TileFill" Foreground="@TileText" Margin="0,0,12,0">
        <Text Content="&#xE7FC;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Solitaire" Width="*" TextVAlign="Center"/>
