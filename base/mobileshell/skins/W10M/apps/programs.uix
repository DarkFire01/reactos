      <Text Content="File Explorer" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Help" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
