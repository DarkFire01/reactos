        <Text Content="&#xE704;" Font="@Glyph24" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Text Content="Internet Sharing" Width="*" TextVAlign="Center"/>
    </Element>
    <Element Layout="Row" Height="@IconItemHeight" Padding="12,10,12,11" Command="launch:Messenger" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
