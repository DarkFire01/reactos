<?xml version="1.0" encoding="utf-8"?>
<!-- Settings app, rendered out of process by settings.exe. Pivot headers switch the tab pages; items are open:<Page>. -->
<Uix Name="Settings" Background="@AppBackground" Layout="Stack" Foreground="@AppText" Font="@Default">

  <Element Name="Tabs" Layout="Stack">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Element Layout="Row" Height="@TabHeight" Padding="12,0,0,0">
      <Element Command="tab:Personal" Margin="0,0,18,0"><Text Content="Personal" Font="@Pivot" Foreground="{TabPersonal}"/></Element>
      <Element Command="tab:System" Margin="0,0,18,0"><Text Content="System" Font="@Pivot" Foreground="{TabSystem}"/></Element>
      <Element Command="tab:Connections"><Text Content="Connections" Font="@Pivot" Foreground="{TabConnections}"/></Element>
    </Element>
  </Element>

  <Element Name="PagePersonal" Scroll="true" Height="*" Layout="Stack" Padding="0,4,0,8" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Buttons" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE7C9;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Buttons"/>
          <Text Content="Hardware buttons and shortcuts" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Input" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE765;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Input"/>
          <Text Content="Keyboard and input panel" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Lock" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE72E;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Lock screen"/>
          <Text Content="Password and device lock" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Owner" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE77B;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Owner information"/>
          <Text Content="Your name and contact details" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Sounds" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE767;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Sounds"/>
          <Text Content="Volume and ringtones" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Today" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE771;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Personalization"/>
          <Text Content="Theme and accent color" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
  </Element>

  <Element Name="PageSystem" Scroll="true" Height="*" Layout="Stack" Padding="0,4,0,8" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3" Visible="false">
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:About" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE946;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="About"/>
          <Text Content="Device information" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="launch:DeviceManager" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE772;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Device Manager"/>
          <Text Content="Devices, drivers and problems" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Backlight" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE706;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Display"/>
          <Text Content="Brightness and screen timeout" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Clock" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE823;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Time &amp; alarms"/>
          <Text Content="Date, time and alarms" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Memory" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xEDA2;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Storage"/>
          <Text Content="Memory and storage use" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Power" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE83F;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Battery"/>
          <Text Content="Battery level and power saving" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Regional" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE775;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Region"/>
          <Text Content="Language, region and formats" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Programs" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE71D;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Apps"/>
          <Text Content="Installed programs" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Screen" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE7F4;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Screen"/>
          <Text Content="Orientation and text size" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:TaskManager" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE9D9;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Running apps"/>
          <Text Content="See and stop running programs" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
  </Element>

  <Element Name="PageConnections" Scroll="true" Height="*" Layout="Stack" Padding="0,4,0,8" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3" Visible="false">
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Cellular" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xEC3B;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Cellular &amp; SIM"/>
          <Text Content="{CellSummary}" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Connections" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE774;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Network"/>
          <Text Content="Data and dial up connections" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:WiFi" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE701;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Wi-Fi"/>
          <Text Content="Wireless networks" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
      <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="open:Wireless" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE709;" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
        <Element Layout="Stack" Width="*" VAlign="Center">
          <Text Content="Airplane mode"/>
          <Text Content="Turn radios on and off" Font="@Caption" Foreground="@AppSubText"/>
        </Element>
      </Element>
  </Element>

  <Element Name="PageInfo" Layout="Stack" Height="*" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Text Content="{InfoTitle}" Font="@TitleText" Padding="12,2,12,8"/>
    <Element Name="InfoScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Repeater Name="InfoRows" Layout="Stack">
        <Element Layout="Stack" Padding="12,6,12,6">
          <Text Content="{Item.Label}" Font="@Caption" Foreground="@AppSubText"/>
          <Text Content="{Item.Value}" Wrap="true"/>
        </Element>
      </Repeater>
    </Element>
  </Element>

  <Element Name="PageOwner" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="Owner information" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="Name" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="owner:0" Background="@FieldFill" BorderBrush="{OwnerFill0}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Owner0}"/>
    </Element>
    <Text Content="Company" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="owner:1" Background="@FieldFill" BorderBrush="{OwnerFill1}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Owner1}"/>
    </Element>
    <Text Content="Phone" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="owner:2" Background="@FieldFill" BorderBrush="{OwnerFill2}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Owner2}"/>
    </Element>
    <Text Content="Email" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="owner:3" Background="@FieldFill" BorderBrush="{OwnerFill3}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Owner3}"/>
    </Element>
    <Text Content="Notes" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="owner:4" Background="@FieldFill" BorderBrush="{OwnerFill4}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Owner4}"/>
    </Element>
  </Element>

  <Element Name="PageSounds" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="Sounds" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="{SoundVolume}" Margin="0,0,0,4"/>
    <Element Layout="Row" Height="40" Margin="0,0,0,12">
      <Element Width="40" Command="volume.down" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE738;" Font="@Glyph16" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Layout="Row" Width="*" Padding="6,16,6,16">
        <Element Width="*" Margin="0,0,2,0" Background="{Vol1}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol2}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol3}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol4}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol5}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol6}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol7}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol8}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol9}"/>
        <Element Width="*" Margin="0,0,2,0" Background="{Vol10}"/>
      </Element>
      <Element Width="40" Command="volume.up" Momentary="true" SelectedBackground="@ListPressed">
        <Text Content="&#xE710;" Font="@Glyph16" TextAlign="Center" TextVAlign="Center"/>
      </Element>
    </Element>
    <Element Height="36" Command="volume.mute" Momentary="true" Background="@ButtonFace" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText" Padding="20,0,20,0">
      <Text Content="{MuteLabel}" TextAlign="Center" TextVAlign="Center"/>
    </Element>
    <Text Content="Changes apply to the system volume." Font="@Caption" Foreground="@AppSubText" Margin="0,12,0,0" Wrap="true"/>
  </Element>

  <Element Name="PageToday" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="Personalization" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="Choose a theme for Start and every app." Font="@Caption" Foreground="@AppSubText" Wrap="true" Margin="0,0,0,8"/>
    <Repeater Name="Themes" Layout="Stack">
      <Element Height="44" Command="{Item.Command}" Background="{Item.Fill}" Padding="12,0,12,0" Selectable="true" Momentary="true"
               SelectedBackground="@ListPressed" Margin="0,0,0,2">
        <Text Content="{Item.Name}" TextVAlign="Center"/>
      </Element>
    </Repeater>
  </Element>

  <!-- About: product name, details, and version / device / legal pivots -->
  <Element Name="PageAbout" Layout="Stack" Height="*" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Element Layout="Row" Height="@TabHeight" Padding="12,0,0,0">
      <Element Command="about:Version" Margin="0,0,18,0"><Text Content="Version" Font="@Pivot" Foreground="{AboutTabVersion}"/></Element>
      <Element Command="about:Device" Margin="0,0,18,0"><Text Content="Device" Font="@Pivot" Foreground="{AboutTabDevice}"/></Element>
      <Element Command="about:Copyrights"><Text Content="Legal" Font="@Pivot" Foreground="{AboutTabCopyrights}"/></Element>
    </Element>
    <Element Name="AboutBrand" Layout="Stack" Padding="12,8,12,8">
      <Text Content="{AboutProduct}" Font="@Subtitle"/>
      <Text Content="{AboutEdition}" Font="@Caption" Foreground="@AppSubText"/>
    </Element>
    <Element Name="AboutScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Repeater Name="AboutRows" Layout="Stack">
        <Element Layout="Stack" Padding="12,6,12,6">
          <Text Content="{Item.Label}" Font="@Caption" Foreground="@AppSubText"/>
          <Text Content="{Item.Value}" Wrap="true"/>
        </Element>
      </Repeater>
    </Element>
  </Element>

  <!-- Cellular & SIM: data switch, live radio, SIM and network state, then SIM settings -->
  <Element Name="PageCellular" Layout="Stack" Height="*" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Text Content="Cellular &amp; SIM" Font="@TitleText" Padding="12,2,12,8"/>
    <Element Name="CellScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Text Content="Cellular data connection" Padding="12,0,12,0"/>
      <Element Layout="Row" Height="44" Padding="12,0,12,0" Command="cell:data" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
        <Element Width="44" Height="20" VAlign="Center" Background="{DataTrack}" BorderBrush="{DataBorder}" BorderThickness="2" Margin="0,0,12,0">
          <Element Name="DataKnobOff" Width="10" Height="10" HAlign="Left" VAlign="Center" Margin="3,0,0,0" Background="@AppText"/>
          <Element Name="DataKnobOn" Width="10" Height="10" HAlign="Right" VAlign="Center" Margin="0,0,3,0" Background="@BaseWhite" Visible="false"/>
        </Element>
        <Text Content="{DataSwitch}" Width="*" TextVAlign="Center"/>
      </Element>
      <Text Content="{DataState}" Font="@Caption" Foreground="@AppSubText" Wrap="true" Padding="12,0,12,12"/>

      <Repeater Name="CellRows" Layout="Stack">
        <Element Layout="Stack" Padding="12,6,12,6">
          <Text Content="{Item.Label}" Font="@Caption" Foreground="@AppSubText"/>
          <Text Content="{Item.Value}" Wrap="true"/>
        </Element>
      </Repeater>

      <Element Height="36" Margin="12,12,12,12" Command="open:Apn" Momentary="true" Background="@ButtonFace" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText" Padding="20,0,20,0" HAlign="Left">
        <Text Content="SIM settings" TextAlign="Center" TextVAlign="Center"/>
      </Element>
    </Element>
  </Element>

  <!-- SIM settings: the internet APN the data connection dials -->
  <Element Name="PageApn" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="SIM settings" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="Internet APN" Font="@Caption" Foreground="@AppSubText" Margin="0,0,0,8"/>
    <Text Content="Access point name" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="apn:0" Background="@FieldFill" BorderBrush="{ApnFill0}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Apn0}"/>
    </Element>
    <Text Content="User name" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="apn:1" Background="@FieldFill" BorderBrush="{ApnFill1}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Apn1}"/>
    </Element>
    <Text Content="Password" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="apn:2" Background="@FieldFill" BorderBrush="{ApnFill2}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{Apn2}"/>
    </Element>
    <Text Content="Type of sign-in info" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Command="apn.auth" Momentary="true" Background="@FieldFill" BorderBrush="@FieldBorder" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14" SelectedBackground="@ListPressed">
      <Text Content="{ApnAuth}"/>
    </Element>
    <Text Content="Save applies the APN and reconnects cellular data when it is on." Font="@Caption" Foreground="@AppSubText" Wrap="true"/>
  </Element>

  <!-- Airplane mode: the cellular radio's power -->
  <Element Name="PageAirplane" Layout="Stack" Height="*" Padding="0,0,0,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Text Content="Airplane mode" Font="@TitleText" Padding="12,2,12,8"/>
    <Text Content="Turn this on to stop all wireless communication." Wrap="true" Padding="12,0,12,4"/>
    <Element Layout="Row" Height="44" Padding="12,0,12,0" Command="cell:airplane" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="44" Height="20" VAlign="Center" Background="{AirTrack}" BorderBrush="{AirBorder}" BorderThickness="2" Margin="0,0,12,0">
        <Element Name="AirKnobOff" Width="10" Height="10" HAlign="Left" VAlign="Center" Margin="3,0,0,0" Background="@AppText"/>
        <Element Name="AirKnobOn" Width="10" Height="10" HAlign="Right" VAlign="Center" Margin="0,0,3,0" Background="@BaseWhite" Visible="false"/>
      </Element>
      <Text Content="{AirSwitch}" Width="*" TextVAlign="Center"/>
    </Element>
    <Text Content="{AirState}" Font="@Caption" Foreground="@AppSubText" Wrap="true" Padding="12,4,12,0"/>
  </Element>

  <!-- Wi-Fi: the radio switch and the networks in range; tapping one opens it -->
  <Element Name="PageWifi" Layout="Stack" Height="*" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="12,12,12,0"/>
    <Text Content="Wi-Fi" Font="@TitleText" Padding="12,2,12,8"/>
    <Text Content="Wi-Fi networking" Padding="12,0,12,0"/>
    <Element Layout="Row" Height="44" Padding="12,0,12,0" Command="wifi.toggle" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
      <Element Width="44" Height="20" VAlign="Center" Background="{WifiTrack}" BorderBrush="{WifiBorder}" BorderThickness="2" Margin="0,0,12,0">
        <Element Name="WifiKnobOff" Width="10" Height="10" HAlign="Left" VAlign="Center" Margin="3,0,0,0" Background="@AppText"/>
        <Element Name="WifiKnobOn" Width="10" Height="10" HAlign="Right" VAlign="Center" Margin="0,0,3,0" Background="@BaseWhite" Visible="false"/>
      </Element>
      <Text Content="{WifiSwitch}" Width="*" TextVAlign="Center"/>
    </Element>
    <Text Content="{WifiState}" Font="@Caption" Foreground="@AppSubText" Wrap="true" Padding="12,0,12,8"/>
    <Element Name="WifiScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Repeater Name="WifiNetworks" Layout="Stack">
        <Element Layout="Row" Height="@SettingsCellHeight" Padding="12,0,12,0" Command="wifi.net:{Item.Id}" Selectable="true" Momentary="true" SelectedBackground="@ListPressed">
          <Text Content="{Item.Glyph}" Font="@ListGlyph" Foreground="@AccentText" Width="40"/>
          <Element Layout="Stack" Width="*" VAlign="Center">
            <Text Content="{Item.Name}"/>
            <Text Content="{Item.Detail}" Font="@Caption" Foreground="@AppSubText"/>
          </Element>
        </Element>
      </Repeater>
    </Element>
  </Element>

  <!-- One network: password for a new secured one, connect, disconnect, forget -->
  <Element Name="PageWifiJoin" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="{JoinName}" Font="@TitleText" Margin="0,2,0,4"/>
    <Text Content="{JoinDetail}" Font="@Caption" Foreground="@AppSubText" Wrap="true" Margin="0,0,0,12"/>
    <Element Name="JoinPasswordBlock" Layout="Stack">
      <Text Content="Password" Font="@Caption" Foreground="@AppSubText"/>
      <Element Height="32" Command="wifi.password" Background="@FieldFill" BorderBrush="{JoinFill}" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,8">
        <Text Content="{JoinPassword}"/>
      </Element>
      <Element Layout="Row" Height="36" Command="wifi.show" Momentary="true" SelectedBackground="@ListPressed" Margin="0,0,0,8">
        <Element Width="20" Height="20" VAlign="Center" BorderBrush="@AppText" BorderThickness="2" Background="{ShowFill}" Margin="0,0,10,0"/>
        <Text Content="Show password" Width="*" TextVAlign="Center"/>
      </Element>
    </Element>
    <Element Layout="Row" Height="36" Margin="0,4,0,8">
      <Element Name="JoinConnect" Command="wifi.connect" Momentary="true" Background="@ButtonFace" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText" Padding="20,0,20,0" Margin="0,0,8,0">
        <Text Content="Connect" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Name="JoinDisconnect" Command="wifi.disconnect" Momentary="true" Background="@ButtonFace" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText" Padding="20,0,20,0" Margin="0,0,8,0">
        <Text Content="Disconnect" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Name="JoinForget" Command="wifi.forget" Momentary="true" Background="@ButtonFace" SelectedBackground="@ItemSelected" SelectedForeground="@ItemSelectedText" Padding="20,0,20,0">
        <Text Content="Forget" TextAlign="Center" TextVAlign="Center"/>
      </Element>
    </Element>
    <Text Content="{JoinStatus}" Font="@Caption" Foreground="@AppSubText" Wrap="true"/>
  </Element>

  <Element Name="PageDetail" Layout="Stack" Height="*" Padding="12,0,12,8" Visible="false">
    <Text Content="SETTINGS" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="{DetailTitle}" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="This setting is not available yet." Foreground="@AppSubText" Wrap="true"/>
  </Element>

</Uix>
