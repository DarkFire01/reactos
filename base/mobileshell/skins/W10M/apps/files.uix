<?xml version="1.0" encoding="utf-8"?>
<!-- File Explorer, rendered out of process by files.exe. Folder picker and sort order on top, item list below. -->
<Uix Name="Files" Background="@AppBackground" Layout="Stack" Foreground="@AppText" Font="@Default">

  <Element Name="PageList" Layout="Stack" Height="*">
    <Text Content="FILE EXPLORER" Font="@BaseFont" Padding="12,12,12,0"/>
    <Element Layout="Row" Height="44" Padding="12,0,4,0">
      <Element Width="*" Layout="Row" Command="folder.menu" Momentary="true" SelectedForeground="@AccentText">
        <Text Content="{FolderName}" Font="@TitleText"/>
        <Text Content="&#xE70D;" Font="@Glyph16" Margin="8,6,0,0" Width="*"/>
      </Element>
      <Element Layout="Row" Command="sort.menu" Momentary="true" Padding="8,0,8,0" SelectedBackground="@ListPressed" Font="@Caption" Foreground="@AppSubText">
        <Text Content="&#xE8CB;" Font="@Glyph16" Margin="0,0,6,0"/>
        <Text Content="{SortName}"/>
      </Element>
    </Element>

    <Element Name="ListScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Repeater Name="Entries" Layout="Stack">
        <Element Name="e{Item.Id}" Layout="Row" Height="@FileRowHeight" Padding="12,0,12,0" Command="{Item.Command}" HoldCommand="hold:{Item.Id}"
                 Selectable="true" SelectedBackground="@ListPressed">
          <Element Width="32" Height="32" VAlign="Center" Margin="0,0,12,0">
            <Text Content="{Item.Glyph}" Font="@FileGlyph" Foreground="{Item.Ink}" TextAlign="Center" TextVAlign="Center"/>
            <Image Source="{Item.Icon}"/>
          </Element>
          <Element Layout="Stack" Width="*" VAlign="Center">
            <Text Content="{Item.Name}"/>
            <Text Content="{Item.Detail}" Font="@Caption" Foreground="@AppSubText" Collapse="true"/>
          </Element>
        </Element>
      </Repeater>
      <Text Name="ListEmpty" Content="This folder is empty." TextAlign="Center" Margin="0,24,0,0" Foreground="@AppSubText" Visible="false"/>
    </Element>
  </Element>

  <Element Name="PageDetails" Layout="Stack" Height="*" Visible="false">
    <Text Content="PROPERTIES" Font="@BaseFont" Padding="12,12,12,0"/>
    <Text Content="{DetailName}" Font="@TitleText" Wrap="true" Padding="12,2,12,8"/>
    <Element Name="DetailScroll" Scroll="true" Height="*" Layout="Stack" ScrollBarBrush="@Transparent" ScrollThumbBrush="@ScrollThumb" ScrollBarWidth="3">
      <Image Name="Preview" Source="{PreviewSource}" Height="180" Margin="12,4,12,8" Visible="false"/>
      <Repeater Name="Properties" Layout="Stack">
        <Element Layout="Stack" Padding="12,6,12,6">
          <Text Content="{Item.Label}" Font="@Caption" Foreground="@AppSubText"/>
          <Text Content="{Item.Value}" Wrap="true"/>
        </Element>
      </Repeater>
    </Element>
  </Element>

  <Element Name="PageRename" Layout="Stack" Height="*" Padding="12,0,12,4" Visible="false">
    <Text Content="FILE EXPLORER" Font="@BaseFont" Padding="0,12,0,0"/>
    <Text Content="Rename" Font="@TitleText" Margin="0,2,0,12"/>
    <Text Content="Name" Font="@Caption" Foreground="@AppSubText"/>
    <Element Height="32" Background="@FieldFill" BorderBrush="@Accent" BorderThickness="2" Padding="10,0,10,0" Margin="0,4,0,14">
      <Text Content="{RenameText}" Highlight="{RenameSelected}"/>
    </Element>
    <Text Content="Tap done or press Back to rename." Font="@Caption" Foreground="@AppSubText" Wrap="true"/>
  </Element>

</Uix>
