<?xml version="1.0" encoding="utf-8"?>
<!-- Start, owned by MobileUI. Tiles are launch commands packed by the Tiles layout; swipe left for All apps. -->
<Uix Name="Home"
     Title="@StartLabel"
     SoftKeyLeft="" SoftKeyLeftCommand=""
     SoftKeyRight="" SoftKeyRightCommand=""
     AppReveal="0,40,0.3,0">

  <Element Name="StartBackdrop" Layer="true" Background="@StartBackground"/>

  <!-- Margins keep the status and navigation bars free for the chrome -->
  <Element Name="Start" Layer="true" Margin="0,@TrayHeight,0,@NavBarHeight" Scroll="true" SwipeLeft="start"
           ScrollBarWidth="0" Layout="Stack">
    <Element Layout="Tiles" Columns="4" Gap="@TileGap" Padding="7,7,7,7">
      <Element Span="2,2" Background="@TileFill" Foreground="@TileText" Command="launch:Contacts" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE716;" Font="@TileGlyph" TextAlign="Center" TextVAlign="Center"/>
        <Text Content="People" Font="@TileLabel" VAlign="Bottom" Margin="8,0,8,6"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:Calculator" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE8EF;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:ClockSettings" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE823;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="4,2" Background="@TileFill" Foreground="@TileText" Command="launch:Calendar" Selectable="true" Momentary="true" SelectedBackground="@TilePressed" Layout="Stack" Padding="8,8,8,6">
        <Text Content="{Weekday}" Font="@TileLive"/>
        <Text Content="{Date}" Font="@TileLive"/>
        <Element Height="*"/>
        <Element Layout="Row">
          <Text Content="Calendar" Font="@TileLabel" Width="*"/>
          <Text Content="&#xE787;" Font="@Glyph16"/>
        </Element>
      </Element>
      <Element Span="2,2" Background="@TileFill" Foreground="@TileText" Command="launch:Settings" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE713;" Font="@TileGlyph" TextAlign="Center" TextVAlign="Center"/>
        <Text Content="Settings" Font="@TileLabel" VAlign="Bottom" Margin="8,0,8,6"/>
      </Element>
      <Element Span="2,2" Background="@TileFill" Foreground="@TileText" Command="launch:Files" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xEC50;" Font="@TileGlyph" TextAlign="Center" TextVAlign="Center"/>
        <Text Content="File Explorer" Font="@TileLabel" VAlign="Bottom" Margin="8,0,8,6"/>
      </Element>
      <Element Span="2,2" Background="@TileFill" Foreground="@TileText" Command="launch:Office" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE8A5;" Font="@TileGlyph" TextAlign="Center" TextVAlign="Center"/>
        <Text Content="Office" Font="@TileLabel" VAlign="Bottom" Margin="8,0,8,6"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:Writer" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE8A5;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:Sheets" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE80A;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:Slides" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE7F4;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="1,1" Background="@TileFill" Foreground="@TileText" Command="launch:Notes" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE70B;" Font="@TileGlyphSmall" TextAlign="Center" TextVAlign="Center"/>
      </Element>
      <Element Span="4,2" Background="@TileFill" Foreground="@TileText" Command="launch:OwnerInfo" Selectable="true" Momentary="true" SelectedBackground="@TilePressed" Layout="Stack" Padding="8,8,8,6">
        <Text Content="&#xE77B;" Font="@Glyph24" Margin="0,0,0,6"/>
        <Text Content="{OwnerLine}" Font="@TileLive" Wrap="true"/>
        <Element Height="*"/>
        <Text Content="Me" Font="@TileLabel"/>
      </Element>
      <Element Span="2,2" Background="@TileFill" Foreground="@TileText" Command="launch:Help" Selectable="true" Momentary="true" SelectedBackground="@TilePressed">
        <Text Content="&#xE82F;" Font="@TileGlyph" TextAlign="Center" TextVAlign="Center"/>
        <Text Content="Getting Started" Font="@TileLabel" VAlign="Bottom" Margin="8,0,8,6"/>
      </Element>
    </Element>

    <Element Layout="Row" Height="44" Padding="0,0,12,0" Command="start" Momentary="true" Foreground="@BaseMid" Font="@Body">
      <Element Width="*"/>
      <Text Content="All apps" Margin="0,0,8,0"/>
      <Text Content="&#xE72A;" Font="@Glyph16"/>
    </Element>
  </Element>

  <!-- The band hosted apps are composed into -->
  <Element Name="AppHost" Margin="0,@TrayHeight,0,@ChromeBottom"/>

</Uix>
