<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar, app bar and navigation bar, owned by ShellChrome. Soft keys are app bar buttons; Back does ok and X. -->
<Uix Name="Chrome" Foreground="@TitleText" Font="@ClockFont" BatteryFillWidth="11">

  <!-- Tapping the status bar opens the action center -->
  <Element Name="StatusBar" Layer="true" VAlign="Top" Height="@TrayHeight" Background="@StatusBar" Layout="Row"
           Command="status" Momentary="true" Padding="12,0,0,0">
    <!-- Tray icons are 16x16 boxes centered in the bar; their ink, the battery and the clock baseline share one bottom line -->
    <Element Width="16" Height="16" VAlign="Center" Layout="Row" Padding="0.5,4,0,0.5" Margin="0,0,6,0">
      <Element Width="2.2" Height="3" VAlign="Bottom" Background="{Bar1}" Margin="0,0,0.9,0"/>
      <Element Width="2.2" Height="5" VAlign="Bottom" Background="{Bar2}" Margin="0,0,0.9,0"/>
      <Element Width="2.2" Height="7" VAlign="Bottom" Background="{Bar3}" Margin="0,0,0.9,0"/>
      <Element Width="2.2" Height="9" VAlign="Bottom" Background="{Bar4}" Margin="0,0,0.9,0"/>
      <Element Width="2.2" Height="11" VAlign="Bottom" Background="{Bar5}"/>
    </Element>
    <Text Name="NetActive" Content="&#xE701;" Font="@TrayGlyph" Width="16" Height="16" VAlign="Center" TextAlign="Center" TextVAlign="Center" Margin="0,0,6,0"/>
    <Text Name="NetOff" Content="&#xE871;" Font="@TrayGlyph" Width="16" Height="16" VAlign="Center" TextAlign="Center" TextVAlign="Center" Margin="0,0,6,0" Visible="false"/>
    <Element Name="NotifyIcon" Command="notify.show" Momentary="true" Visible="false" Width="16" Height="16" VAlign="Center" Margin="0,0,6,0">
      <Text Content="&#xE8BD;" Font="@TrayGlyph" TextAlign="Center" TextVAlign="Center"/>
    </Element>
    <Element Width="*"/>
    <Text Name="BatteryCharging" Content="&#xE945;" Font="@TrayGlyph" Width="16" Height="16" VAlign="Center" TextAlign="Center" TextVAlign="Center" Visible="false"/>
    <Element Width="16" Height="16" VAlign="Center" Layout="Row" Padding="0,8.5,0,0.5">
      <Element Width="15" BorderBrush="@TitleText" BorderThickness="1" Padding="1">
        <Element Width="{BatteryLevel}" HAlign="Left" Background="{BatteryBrush}"/>
      </Element>
      <Element Width="1" Background="@TitleText" Margin="0,2,0,2"/>
    </Element>
    <Text Name="StatusTime" Content="{Time}" TextAlign="Right" Padding="10,5.5,12,0"/>
  </Element>

  <!-- Shown only while an app is up; the keyboard and the toast cover it -->
  <Element Name="AppBar" Layer="true" VAlign="Bottom" Height="@AppBarHeight" Margin="0,0,0,@NavBarHeight"
           Background="@AppBar" Layout="Row" Foreground="@AppBarText" Font="@AppBarLabel" Padding="8,0,0,0">
    <Element Width="*"/>
    <Element Command="softkey.left" Momentary="true" SelectedBackground="@AppBarPressed" Padding="12,0,12,0">
      <Text Content="{SoftKeyLeft}" TextVAlign="Center"/>
    </Element>
    <Element Command="softkey.right" Momentary="true" SelectedBackground="@AppBarPressed" Padding="12,0,12,0" Margin="4,0,0,0">
      <Text Content="{SoftKeyRight}" TextVAlign="Center"/>
    </Element>
    <!-- The "..." spot opens the keyboard here; menus come from the right soft key -->
    <Element Width="48" Command="softkey.center" Momentary="true" SelectedBackground="@AppBarPressed">
      <Text Content="&#xE712;" Font="@Glyph16" TextAlign="Center" TextVAlign="Center"/>
    </Element>
  </Element>

  <Element Name="NavBar" Layer="true" VAlign="Bottom" Height="@NavBarHeight" Background="@NavBar" Layout="Row" Foreground="@NavGlyphColor">
    <Element Width="*"/>
    <Element Width="48" Command="back" HoldCommand="switcher" Momentary="true" SelectedBackground="@ListPress">
      <Text Content="&#xE72B;" Font="@NavGlyph" TextAlign="Center" TextVAlign="Center"/>
    </Element>
    <Element Width="48"/>
    <Element Width="48" Command="home" HoldCommand="start" Momentary="true" SelectedBackground="@ListPress">
      <Image Source="@StartLogo" Width="32" Height="32" HAlign="Center" VAlign="Center"/>
    </Element>
    <Element Width="48"/>
    <Element Width="48" Command="launch:Search" Momentary="true" SelectedBackground="@ListPress">
      <Text Content="&#xE721;" Font="@NavGlyph" TextAlign="Center" TextVAlign="Center"/>
    </Element>
    <Element Width="*"/>
  </Element>

</Uix>
