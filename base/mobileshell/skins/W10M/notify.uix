<?xml version="1.0" encoding="utf-8"?>
<!-- Toast, owned by MobileUI. Slides over the status bar; tap keeps it for later, a sideways swipe dismisses it. -->
<Uix Name="Notify" SoftKeyLeft="@NotifyDismiss" SoftKeyRight="@NotifyHide">
  <Element Name="NotifyRoot" Visible="false">
    <Element Name="NotifyBanner" Layer="true" VAlign="Top" Layout="Stack" Background="@NotifyBackground"
             Foreground="@NotifyText" Font="@Body" Reveal="0,-80,0.3,0"
             SwipeLeft="notify.dismiss" SwipeRight="notify.dismiss">

      <Element Layout="Row" Height="80" Padding="12,16,12,0" Command="notify.hide" Momentary="true" SelectedBackground="@ListPress">
        <Element Width="20" Height="20" VAlign="Top" Background="@Accent" Foreground="@TileText" Margin="0,0,12,0">
          <Text Content="&#xEA8F;" Font="@Glyph12" TextAlign="Center" TextVAlign="Center"/>
        </Element>
        <Element Layout="Stack" Width="*">
          <Text Content="{NotifyTitle}" Font="@BaseFont" Margin="0,0,0,2"/>
          <Text Content="{NotifyBody}" Foreground="@BaseMid" Wrap="true" Margin="0,0,0,8"/>
        </Element>
      </Element>

      <!-- Handle bar -->
      <Element Height="16" Command="notify.dismiss" Momentary="true">
        <Text Content="&#xE76F;" Font="@Glyph16" Foreground="@BaseHigh" TextAlign="Center" TextVAlign="Center"/>
      </Element>
    </Element>
  </Element>
</Uix>
