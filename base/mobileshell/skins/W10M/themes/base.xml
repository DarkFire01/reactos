<?xml version="1.0" encoding="utf-8"?>
<!-- Shared fonts, metrics, images and strings, in view pixels. The theme files add the colors. -->
<Theme Name="Base">
  <!-- Type ramp: caption 12, body 15, base 15 semibold, subtitle 20, title 24, subheader 34, header 46 -->
  <Font Name="Default" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="Body" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="BaseFont" Family="Segoe UI, Source Sans Pro" Size="15" Weight="600"/>
  <Font Name="Caption" Family="Segoe UI, Source Sans Pro" Size="12"/>
  <Font Name="Subtitle" Family="Segoe UI, Source Sans Pro" Size="20"/>
  <Font Name="TitleText" Family="Segoe UI, Source Sans Pro" Size="24" Weight="350"/>
  <Font Name="SubHeader" Family="Segoe UI, Source Sans Pro" Size="34" Weight="300"/>
  <Font Name="Header" Family="Segoe UI, Source Sans Pro" Size="46" Weight="300"/>
  <Font Name="Pivot" Family="Segoe UI, Source Sans Pro" Size="24" Weight="350"/>
  <Font Name="ClockFont" Family="Segoe UI, Source Sans Pro" Size="13"/>
  <Font Name="TileLabel" Family="Segoe UI, Source Sans Pro" Size="11"/>
  <Font Name="TileLive" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="TileNumber" Family="Segoe UI, Source Sans Pro" Size="46" Weight="300"/>
  <Font Name="AppBarLabel" Family="Segoe UI, Source Sans Pro" Size="15" Weight="600"/>
  <Font Name="MenuFont" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="KeyFont" Family="Segoe UI, Source Sans Pro" Size="20"/>
  <Font Name="KeySmall" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="DocFont" Family="Segoe UI, Source Sans Pro" Size="15"/>
  <Font Name="SlideTitleFont" Family="Segoe UI, Source Sans Pro" Size="34" Weight="300"/>
  <Font Name="SlideFont" Family="Segoe UI, Source Sans Pro" Size="20"/>
  <Font Name="CalcDisplayFont" Family="Segoe UI, Source Sans Pro" Size="46" Weight="300"/>
  <Font Name="CalcKeyFont" Family="Segoe UI, Source Sans Pro" Size="20"/>

  <!-- Segoe MDL2 Assets glyphs -->
  <Font Name="TrayGlyph" Family="Segoe MDL2 Assets" Size="16"/>
  <Font Name="NavGlyph" Family="Segoe MDL2 Assets" Size="20"/>
  <Font Name="Glyph16" Family="Segoe MDL2 Assets" Size="16"/>
  <Font Name="Glyph12" Family="Segoe MDL2 Assets" Size="12"/>
  <Font Name="Glyph20" Family="Segoe MDL2 Assets" Size="20"/>
  <Font Name="Glyph24" Family="Segoe MDL2 Assets" Size="24"/>
  <Font Name="ListGlyph" Family="Segoe MDL2 Assets" Size="28"/>
  <Font Name="TileGlyph" Family="Segoe MDL2 Assets" Size="40"/>
  <Font Name="TileGlyphSmall" Family="Segoe MDL2 Assets" Size="22"/>
  <Font Name="KeyGlyph" Family="Segoe MDL2 Assets" Size="18"/>
  <Font Name="FileGlyph" Family="Segoe MDL2 Assets" Size="28"/>

  <!-- Chrome -->
  <Metric Name="TrayHeight" Value="24"/>
  <Metric Name="NavBarHeight" Value="48"/>
  <Metric Name="AppBarHeight" Value="48"/>
  <Metric Name="ChromeBottom" Value="96"/>
  <Metric Name="TitleHeight" Value="24"/>
  <Metric Name="SoftKeyHeight" Value="48"/>

  <!-- Start and lists -->
  <Metric Name="TileGap" Value="7"/>
  <Metric Name="AppIcon" Value="42"/>
  <Metric Name="ListItemHeight" Value="44"/>
  <Metric Name="IconItemHeight" Value="63"/>
  <Metric Name="FileRowHeight" Value="63"/>
  <Metric Name="SettingsCellWidth" Value="320"/>
  <Metric Name="SettingsCellHeight" Value="63"/>
  <Metric Name="TabHeight" Value="40"/>
  <Metric Name="PopupItemHeight" Value="44"/>
  <Metric Name="PopupSeparatorHeight" Value="9"/>
  <Metric Name="PopupMinWidth" Value="240"/>
  <Metric Name="SipKeyHeight" Value="56"/>
  <Metric Name="DayCellWidth" Value="45"/>
  <Metric Name="DayCellHeight" Value="40"/>
  <Metric Name="SheetHeaderWidth" Value="26"/>
  <Metric Name="SheetCellWidth" Value="58"/>
  <Metric Name="SheetRowHeight" Value="32"/>
  <Metric Name="DragSlop" Value="8"/>
  <Metric Name="SwipeDistance" Value="40"/>

  <Image Name="FolderIcon" Source="..\assets\folder.png" Scale="2"/>
  <ImageSet Prefix="Icon." Directory="..\assets\icons" Scale="2"/>

  <String Name="StartLabel" Value="Start"/>
  <String Name="CloseOk" Value="Done"/>
  <String Name="CloseX" Value="Close"/>
  <String Name="NotInstalled" Value="This app isn't installed yet."/>
  <String Name="NotifyDismiss" Value="Dismiss"/>
  <String Name="NotifyHide" Value="Later"/>
  <String Name="OwnerPrompt" Value="Tap to add your name"/>

  <!-- Colors that do not follow the theme -->
  <Color Name="BaseWhite" Value="#FFFFFF"/>
  <Color Name="BaseBlack" Value="#000000"/>
  <Color Name="TileText" Value="#FFFFFF"/>
  <Color Name="BatteryLow" Value="#E81123"/>
  <Color Name="FolderColor" Value="#E8B33A"/>
  <Color Name="DriveColor" Value="#8A8A8A"/>
  <Color Name="Transparent" Value="#00000000"/>
  <Color Name="SlideBackground" Value="#1F1F1F"/>
  <Color Name="SlideText" Value="#CCFFFFFF"/>
  <Color Name="SlideTitleText" Value="#FFFFFF"/>
</Theme>
